DATABASE_URL=postgresql://gateway:gateway@localhost:5432/gateway
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
ADMIN_TOKEN=
INJECTION_FLAG_THRESHOLD=0.4
INJECTION_BLOCK_THRESHOLD=0.8
PII_SCORE_THRESHOLD=0.5
MAX_INPUT_CHARS=200000
PII_ENTITIES=["EMAIL_ADDRESS","IN_PHONE","AADHAAR","IN_PAN","CREDIT_CARD"]
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_MAX_TEMPERATURE=0.7
CACHE_MAX_BYTES=102400
CACHE_LOOKUP_TIMEOUT_S=1.5
CACHE_CLEANUP_INTERVAL_S=600
SEMANTIC_ENABLED=true
SEMANTIC_THRESHOLD=0.95
SEMANTIC_MIN_CHARS=8
SEMANTIC_MAX_CHARS=1000
EMBED_MODEL=BAAI/bge-small-en-v1.5
FASTEMBED_CACHE_DIR=.cache/fastembed
MODELS_CONFIG_PATH=config/models.yaml
REQUEST_DEADLINE_S=45
PROVIDER_CALL_TIMEOUT_S=30
STREAM_FIRST_CHUNK_TIMEOUT_S=15
MAX_ATTEMPTS_PER_CANDIDATE=2
RETRY_BACKOFF_BASE_S=0.25
RETRY_BACKOFF_CAP_S=2.0
BREAKER_FAILURE_THRESHOLD=5
BREAKER_COOLDOWN_S=30
BREAKER_MAX_COOLDOWN_S=300
PENALTY_DEFAULT_S=10
PENALTY_MAX_S=60
PENALTY_MODEL_NOT_FOUND_S=300